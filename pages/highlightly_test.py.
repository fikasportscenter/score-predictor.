"""Owner-only test page for the Highlightly API (shows what the key can see).
Needs the secret  HIGHLIGHTLY_KEY  and your ADMIN_PASSWORD."""
import hmac
import json
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timedelta, timezone

import streamlit as st

st.set_page_config(page_title="Highlightly test", page_icon="🔧")
BASE = "https://soccer.highlightly.net"


def secret(name, default=""):
    try:
        return str(st.secrets.get(name, default))
    except Exception:
        return default


KEY = ""
for _n in ("HIGHLIGHTLY_KEY", "HIGHLIGHTLY_API_KEY", "HIGHLIGHTLY"):
    KEY = KEY or secret(_n).strip()


def call(path, params):
    """Returns (status, parsed_json_or_text, rate_limit_headers)."""
    q = {k: v for k, v in params.items() if v not in ("", None)}
    url = BASE + path + ("?" + urllib.parse.urlencode(q) if q else "")
    req = urllib.request.Request(url, headers={
        "x-rapidapi-key": KEY, "Accept": "application/json",
        "User-Agent": "score-predictor-test"})
    try:
        with urllib.request.urlopen(req, timeout=25) as r:
            body, status, hdrs = r.read(), r.status, dict(r.headers)
    except urllib.error.HTTPError as e:
        body, status, hdrs = e.read(), e.code, dict(e.headers)
    except Exception as e:
        return None, f"Could not connect: {e}", {}
    try:
        data = json.loads(body.decode("utf-8"))
    except Exception:
        data = body.decode("utf-8", "replace")[:2000]
    rl = {k: v for k, v in hdrs.items() if "limit" in k.lower() or "remaining" in k.lower()}
    return status, data, rl


def items_of(data):
    if isinstance(data, dict):
        d = data.get("data")
        if isinstance(d, list):
            return d
    return data if isinstance(data, list) else []


def nm(x):
    return (x.get("name") if isinstance(x, dict) else x) or ""


def show(status, data, rl, kind):
    if status is None:
        st.error(data)
        return
    (st.success if status == 200 else st.error)(f"Answer code: {status}")
    if rl:
        st.caption("Requests info: " + ", ".join(f"{k}={v}" for k, v in rl.items()))
    if isinstance(data, dict):
        pg, plan = data.get("pagination"), data.get("plan")
        if pg:
            st.caption(f"Pagination: {pg}")
        if plan:
            st.caption(f"Plan: {plan}")
        if status != 200:
            st.code(json.dumps(data, indent=2)[:1500], language="json")
            return
    elif status != 200:
        st.code(str(data)[:1500])
        return
    rows = items_of(data)
    st.write(f"{len(rows)} result(s) on this page")
    if rows:
        lines = []
        for r in rows[:60]:
            if not isinstance(r, dict):
                lines.append(f"- {r}")
            elif kind == "matches":
                stt = r.get("state") or {}
                lines.append(f"- {str(r.get('date',''))[:16]} · {nm(r.get('country'))} · "
                             f"{nm(r.get('league'))} · {nm(r.get('homeTeam'))} vs "
                             f"{nm(r.get('awayTeam'))} · {stt.get('description','')} "
                             f"{stt.get('score','') if not isinstance(stt.get('score'), dict) else stt.get('score')}")
            elif kind == "leagues":
                lines.append(f"- {r.get('id')} · {nm(r)} · {nm(r.get('country'))}")
            else:
                lines.append(f"- {r.get('code', r.get('id', ''))} · {nm(r)}")
        st.markdown("\n".join(lines))
    with st.expander("Raw answer (send a screenshot of this if something looks wrong)"):
        st.code(json.dumps(data, indent=2, ensure_ascii=False)[:6000], language="json")


# ---------- owner login ----------
admin_pw = secret("ADMIN_PASSWORD")
st.title("🔧 Highlightly test")
if not admin_pw:
    st.error("ADMIN_PASSWORD is not set in Secrets.")
    st.stop()
if not st.session_state.get("hl_ok"):
    pw = st.text_input("Owner password", type="password")
    if st.button("Log in"):
        if hmac.compare_digest(pw, admin_pw):
            st.session_state["hl_ok"] = True
            st.rerun()
        else:
            st.error("Wrong password.")
    st.stop()

if not KEY:
    st.error("No key found. Add HIGHLIGHTLY_KEY = \"your key\" in Secrets, save, and reboot.")
    st.stop()
st.caption(f"Key found (ends with …{KEY[-4:]}). Free plan = 100 requests a day. "
           "Each button below uses 1 request.")

st.subheader("1. Does the key work?")
if st.button("Check key (list countries)", use_container_width=True):
    show(*call("/countries", {}), "countries")

st.subheader("2. Find leagues of a country")
country = st.text_input("Country name", value="Uganda")
league_q = st.text_input("Or league name (optional)", placeholder="Premier League")
if st.button("Find leagues", use_container_width=True):
    show(*call("/leagues", {"countryName": country if not league_q else "",
                            "leagueName": league_q, "limit": 50}), "leagues")

st.subheader("3. Matches on a day")
day = st.date_input("Date", value=datetime.now(timezone.utc).date() + timedelta(days=0))
mc = st.text_input("Country name (optional)", value="", key="mc")
ml = st.text_input("League name (optional)", value="", key="ml")
if st.button("Show matches", use_container_width=True):
    show(*call("/matches", {"date": day.isoformat(), "countryName": mc, "leagueName": ml,
                            "timezone": "Africa/Kampala", "limit": 100}), "matches")

if st.button("Log out"):
    st.session_state["hl_ok"] = False
    st.rerun()